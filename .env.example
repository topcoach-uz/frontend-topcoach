# Client-side environment variables for the Vite app.
# Copy to `.env.local` and fill in. Only VITE_-prefixed vars are exposed to the
# browser, so never put secrets here — every value below ships in the bundle.

# --- PostHog (product analytics) ---
# Project API key from PostHog → Settings → Project. Public, client-side token.
# Leave empty to disable PostHog (no SDK init, no network calls).
VITE_PUBLIC_POSTHOG_KEY=
# API host. US cloud: https://us.i.posthog.com  |  EU cloud: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error monitoring) ---
# Leave empty to disable Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# --- Google Analytics 4 ---
# Measurement ID (G-XXXXXXXXXX). Leave empty to disable GA4.
VITE_GA4_MEASUREMENT_ID=

# Enroll new users into server-backed onboarding v2. Existing v2 users stay pinned.
VITE_ONBOARDING_V2_ENABLED=false

# Read-only Bachelor/Master overview and shared applicant shell. Deploy the
# /student-hub/overview API first. Rebuild with false to restore the existing hub.
VITE_APPLICANT_WORKSPACE_ENABLED=false
